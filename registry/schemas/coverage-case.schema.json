{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/coverage-case.schema.json",
  "title": "RES semantic coverage case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_id",
    "title",
    "description",
    "taxonomy",
    "applicability",
    "documentation",
    "confidence",
    "requirements",
    "prerequisites",
    "res_module",
    "fixtures",
    "expectations",
    "cleanup",
    "concurrency",
    "external_dependencies",
    "notes",
    "implementation_status",
    "verification_status",
    "evidence_refs",
    "lifecycle",
    "case_kind",
    "component_semantic_ids",
    "negative_dimensions",
    "required_capabilities",
    "isolation",
    "phases",
    "mutable_resources",
    "comparison_policy_ref",
    "expectation_governance"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "semantic_id": {
      "type": "string",
      "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "feature",
        "operation",
        "variant",
        "interactions"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "interactions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_ids",
        "excluded_configurations"
      ],
      "properties": {
        "release_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^IBMI-[0-9]+\\.[0-9]+$"
          }
        },
        "excluded_configurations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "documentation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "uri"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ibm_documentation",
              "standard",
              "experimental_evidence",
              "project"
            ]
          },
          "title": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "documented_unverified",
        "requires_investigation",
        "experimentally_observed"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "objects",
        "infrastructure",
        "configuration"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "infrastructure": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "configuration": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
      }
    },
    "res_module": {
      "enum": [
        "common",
        "customers",
        "accounts",
        "orders",
        "payments",
        "accounting",
        "reporting",
        "operations"
      ]
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "setup",
        "test_input"
      ],
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_input": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "database_state",
        "messages",
        "job_state",
        "queue_state",
        "spool_state",
        "filesystem_state",
        "error_behavior"
      ],
      "properties": {
        "output": {},
        "database_state": {},
        "messages": {},
        "job_state": {},
        "queue_state": {},
        "spool_state": {},
        "filesystem_state": {},
        "error_behavior": {}
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "procedure",
        "idempotent"
      ],
      "properties": {
        "procedure": {
          "type": "string"
        },
        "idempotent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "concurrency": {
      "type": "object",
      "required": [
        "mode",
        "max_parallel"
      ],
      "properties": {
        "mode": {
          "enum": [
            "isolated",
            "serial",
            "coordinated"
          ]
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_status": {
      "enum": [
        "specified",
        "source_written",
        "statically_validated",
        "blocked",
        "unsupported",
        "requires_investigation"
      ]
    },
    "verification_status": {
      "enum": [
        "not_run",
        "compiled_on_ibmi",
        "executed_on_ibmi",
        "behavior_verified_on_ibmi",
        "integration_verified",
        "blocked",
        "unsupported",
        "requires_investigation"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_definition_version",
        "created_at",
        "modified_at",
        "supersedes",
        "superseded_by",
        "deprecated",
        "change_rationale"
      ],
      "properties": {
        "semantic_definition_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
          }
        },
        "deprecated": {
          "type": "boolean"
        },
        "change_rationale": {
          "type": "string"
        }
      }
    },
    "case_kind": {
      "enum": [
        "single_feature",
        "pairwise_interaction",
        "multi_feature_interaction",
        "concurrency",
        "failure",
        "recovery",
        "lifecycle",
        "security",
        "performance_sensitive"
      ]
    },
    "component_semantic_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
      }
    },
    "negative_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "invalid_input",
          "missing_object",
          "wrong_object_type",
          "authority_failure",
          "malformed_data",
          "timeout",
          "lock_conflict",
          "unavailable_resource",
          "external_dependency_failure",
          "interrupted_execution",
          "cleanup_after_failure"
        ]
      }
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "minimum_version",
          "required_configuration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "minimum_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_configuration": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "exclusive_resources"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "library",
              "schema",
              "user_profile",
              "job",
              "qtemp",
              "library_list",
              "job_description",
              "job_queue",
              "subsystem",
              "output_queue",
              "message_queue",
              "data_queue",
              "journal",
              "spool",
              "filesystem_path",
              "external_integration_namespace"
            ]
          }
        },
        "exclusive_resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition_validation",
        "setup",
        "execution",
        "observation",
        "cleanup",
        "cleanup_verification"
      ],
      "properties": {
        "precondition_validation": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "cleanup": {
          "type": "string",
          "minLength": 1
        },
        "cleanup_verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutable_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "identifier_template",
          "orphan_detection"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "identifier_template": {
            "type": "string"
          },
          "orphan_detection": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "comparison_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "expectation_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_class",
        "evidence_required",
        "independent_review_required"
      ],
      "properties": {
        "change_class": {
          "enum": [
            "initial_definition",
            "implementation_only",
            "semantic_change"
          ]
        },
        "evidence_required": {
          "type": "boolean"
        },
        "independent_review_required": {
          "const": true
        }
      }
    }
  }
}
