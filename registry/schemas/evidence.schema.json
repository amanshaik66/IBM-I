{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantic_id",
    "execution_id",
    "timestamp",
    "environment",
    "source",
    "object_hashes",
    "commands",
    "compiler_messages",
    "job",
    "state",
    "exit_status",
    "expected_behavior",
    "observed_behavior",
    "comparison",
    "result",
    "artifacts",
    "authority",
    "evidence_sha256",
    "semantic_definition_version",
    "comparison_policy_ref",
    "job_log_artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "semantic_id": {
      "type": "string",
      "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "fingerprint",
        "fingerprint_sha256"
      ],
      "properties": {
        "environment_id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint_id",
            "captured_at",
            "ibmi_release",
            "technology_refresh",
            "ptf_groups",
            "partition",
            "processor_architecture",
            "licensed_products",
            "compilers",
            "db2_level",
            "sql_services",
            "ccsid",
            "locale",
            "timezone",
            "language_id",
            "formats",
            "system_values",
            "job_attributes",
            "user_profile",
            "library_list",
            "work_management",
            "capability_flags"
          ],
          "properties": {
            "fingerprint_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            },
            "ibmi_release": {
              "type": [
                "string",
                "null"
              ]
            },
            "technology_refresh": {
              "type": [
                "string",
                "null"
              ]
            },
            "ptf_groups": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "partition": {
              "type": "object"
            },
            "processor_architecture": {
              "type": [
                "string",
                "null"
              ]
            },
            "licensed_products": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "compilers": {
              "type": "object",
              "properties": {
                "rpg": {},
                "cobol": {},
                "c_cpp": {}
              },
              "additionalProperties": true
            },
            "db2_level": {
              "type": [
                "string",
                "null"
              ]
            },
            "sql_services": {
              "type": "object"
            },
            "ccsid": {
              "type": [
                "integer",
                "null"
              ]
            },
            "locale": {
              "type": [
                "string",
                "null"
              ]
            },
            "timezone": {
              "type": [
                "string",
                "null"
              ]
            },
            "language_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "formats": {
              "type": "object",
              "properties": {
                "date": {},
                "time": {},
                "decimal": {}
              },
              "additionalProperties": true
            },
            "system_values": {
              "type": "object"
            },
            "job_attributes": {
              "type": "object"
            },
            "user_profile": {
              "type": "object"
            },
            "library_list": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "work_management": {
              "type": "object",
              "properties": {
                "subsystem": {},
                "job_queue": {},
                "job_description": {}
              },
              "additionalProperties": true
            },
            "capability_flags": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "hash"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "object_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "compile",
        "execution"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compile": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compiler_messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "job": {
      "type": [
        "object",
        "null"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_before",
        "database_after",
        "messages",
        "queues",
        "spool",
        "filesystem"
      ],
      "properties": {
        "database_before": {},
        "database_after": {},
        "messages": {},
        "queues": {},
        "spool": {},
        "filesystem": {}
      }
    },
    "exit_status": {
      "type": "object",
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "expected_behavior": {},
    "observed_behavior": {},
    "comparison": {
      "type": "object",
      "required": [
        "matched",
        "differences"
      ],
      "properties": {
        "matched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "differences": {
          "type": "array",
          "items": {}
        }
      },
      "additionalProperties": false
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "sha256",
          "media_type",
          "size_bytes",
          "logical_role",
          "storage_locator",
          "created_at",
          "execution_id"
        ],
        "properties": {
          "artifact_type": {
            "enum": [
              "compiler_listing",
              "job_log",
              "spool_file",
              "database_snapshot",
              "journal_extract",
              "queue_dump",
              "filesystem_file",
              "binary_payload",
              "screen_capture",
              "structured_trace",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "logical_role": {
            "type": "string"
          },
          "storage_locator": {
            "type": "string",
            "pattern": "^sha256/[0-9a-f]{2}/[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "execution_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "level",
        "adapter",
        "reason"
      ],
      "properties": {
        "level": {
          "enum": [
            "authoritative",
            "non_authoritative"
          ]
        },
        "adapter": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_definition_version": {
      "type": "string"
    },
    "comparison_policy_ref": {
      "type": "string"
    },
    "job_log_artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
