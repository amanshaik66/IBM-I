{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/task-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "semantic_id",
    "objective",
    "allowed_directories",
    "forbidden_changes",
    "prerequisites",
    "expected_deliverables",
    "res_module",
    "required_source",
    "required_test_fixture",
    "required_setup",
    "required_cleanup",
    "required_documentation",
    "verification_requirements",
    "completion_criteria",
    "change_scope",
    "assigned_role",
    "independent_review",
    "workflow_ids",
    "component_ids",
    "capability_ids",
    "coverage_placement"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
    },
    "semantic_id": {
      "type": "string",
      "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "allowed_directories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "forbidden_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "res_module": {
      "type": "string"
    },
    "required_source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_test_fixture": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_setup": {
      "type": "string"
    },
    "required_cleanup": {
      "type": "string"
    },
    "required_documentation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "change_scope": {
      "enum": [
        "implementation_only",
        "semantic_definition"
      ]
    },
    "assigned_role": {
      "enum": [
        "implementer",
        "verifier",
        "reviewer"
      ]
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "implementer_may_self_approve"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "implementer_may_self_approve": {
          "const": false
        }
      }
    },
    "workflow_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^RES-WF-[A-Z]+-[0-9]{4}$"
      }
    },
    "component_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^RES-[A-Z]+-[A-Z0-9-]+$"
      }
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^IBMICAP-[A-Z0-9-]+$"
      }
    },
    "coverage_placement": {
      "enum": [
        "business_integrated",
        "operations_integrated",
        "semantic_edge"
      ]
    }
  }
}
