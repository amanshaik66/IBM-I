{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/baseline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "baseline_version",
    "semantic_id",
    "semantic_definition_version",
    "source_commit",
    "environment_fingerprint_sha256",
    "evidence_package_sha256",
    "comparison_policy",
    "created_at",
    "status",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "baseline_id": {
      "type": "string"
    },
    "baseline_version": {
      "type": "string"
    },
    "semantic_id": {
      "type": "string",
      "pattern": "^IBMSEM-[A-Z0-9]+-[A-Z0-9]+-[0-9]{4}$"
    },
    "semantic_definition_version": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "environment_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "comparison_policy": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "candidate",
        "authoritative",
        "superseded",
        "invalidated"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
