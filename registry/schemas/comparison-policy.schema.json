{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/comparison-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "reviewed",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "reviewed": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation",
          "parameters",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "ignore_volatile",
              "normalize_timestamp",
              "normalize_job_id",
              "normalize_spool_number",
              "unordered_collection",
              "timing_tolerance",
              "exact_numeric",
              "decimal_precision",
              "binary_exact",
              "ordered_events"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
