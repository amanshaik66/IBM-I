{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/res-workflow-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "estate": {
      "const": "RES"
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputs",
          "modules",
          "components",
          "database_entities",
          "ibmi_objects",
          "platform_capabilities",
          "synchronous_interactions",
          "asynchronous_interactions",
          "external_dependencies",
          "expected_outputs",
          "transactional_boundaries",
          "failure_paths",
          "recovery_path",
          "future_semantic_families",
          "semantic_case_ids",
          "workflow_id",
          "title",
          "business_purpose",
          "initiating_actor",
          "security_context",
          "execution_class",
          "status"
        ],
        "properties": {
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "database_entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ibmi_objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "platform_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "synchronous_interactions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "asynchronous_interactions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transactional_boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recovery_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "future_semantic_families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semantic_case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflow_id": {
            "type": "string",
            "pattern": "^RES-WF-[A-Z]+-[0-9]{4}$"
          },
          "title": {
            "type": "string"
          },
          "business_purpose": {
            "type": "string"
          },
          "initiating_actor": {
            "type": "string"
          },
          "security_context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution_class": {
            "enum": [
              "interactive",
              "batch",
              "service",
              "asynchronous",
              "hybrid"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "foundation_fixture",
              "implemented"
            ]
          }
        }
      }
    }
  }
}
