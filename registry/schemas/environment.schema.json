{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://res.example/schemas/environment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_id",
    "kind",
    "release_id",
    "authority",
    "workspace",
    "capability_adapters",
    "secret_refs",
    "limits",
    "fingerprint",
    "capabilities",
    "security_personas"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "kind": {
      "enum": [
        "ibmi",
        "mock"
      ]
    },
    "release_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^IBMI-[0-9]+\\.[0-9]+$"
    },
    "authority": {
      "enum": [
        "authoritative_candidate",
        "non_authoritative"
      ]
    },
    "workspace": {
      "type": "object",
      "required": [
        "library_prefix",
        "ifs_root"
      ],
      "properties": {
        "library_prefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,5}$"
        },
        "ifs_root": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "capability_adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secret_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_concurrent_jobs",
        "command_timeout_seconds"
      ],
      "properties": {
        "max_concurrent_jobs": {
          "type": "integer",
          "minimum": 1
        },
        "command_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "fingerprint": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "fingerprint_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "ibmi_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "technology_refresh": {
          "type": [
            "string",
            "null"
          ]
        },
        "ptf_groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "partition": {
          "type": "object"
        },
        "processor_architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "licensed_products": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "compilers": {
          "type": "object",
          "properties": {
            "rpg": {},
            "cobol": {},
            "c_cpp": {}
          },
          "additionalProperties": true
        },
        "db2_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "sql_services": {
          "type": "object"
        },
        "ccsid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "language_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "formats": {
          "type": "object",
          "properties": {
            "date": {},
            "time": {},
            "decimal": {}
          },
          "additionalProperties": true
        },
        "system_values": {
          "type": "object"
        },
        "job_attributes": {
          "type": "object"
        },
        "user_profile": {
          "type": "object"
        },
        "library_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_management": {
          "type": "object",
          "properties": {
            "subsystem": {},
            "job_queue": {},
            "job_description": {}
          },
          "additionalProperties": true
        },
        "capability_flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "version",
          "attributes",
          "configuration_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "status": {
            "enum": [
              "available",
              "unavailable",
              "unknown",
              "requires_configuration"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "type": "object"
          },
          "configuration_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "security_personas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
