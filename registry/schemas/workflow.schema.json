{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workflows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "steps",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "string"
          }
        }
      }
    }
  }
}
